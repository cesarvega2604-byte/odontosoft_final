# Copia esta plantilla como .env y completa las claves de tu instalacion.
# Usa odontosoft_demo si estas conectando una base existente con ese nombre.
DB_NAME=odontosoft_ultimate
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# Correo automatico. Completa estos valores solo si vas a habilitar SMTP.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Opcional para la aplicacion web desplegada fuera del equipo.
# FRONTEND_URL=https://tu-dominio
# ODONTO_WEB_ORIGINS=https://tu-dominio
